FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV VITE_API_BASE_URL=/admin
RUN npm run build -- --base=/admin/

FROM nginx:1.30.6-alpine
COPY nginx.prod.conf.template /etc/nginx/templates/default.conf.template
COPY 40-check-admin-key.sh /docker-entrypoint.d/40-check-admin-key.sh
RUN chmod +x /docker-entrypoint.d/40-check-admin-key.sh
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
